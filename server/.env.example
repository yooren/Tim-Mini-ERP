# 服务端监听端口
PORT=3000

# 数据库类型：sqlite（默认，零配置，数据存本地文件）或 mysql（独立部署的 MySQL/MariaDB）
DB_TYPE=sqlite

# ===== DB_TYPE=sqlite 时使用 =====
# 数据库文件路径（相对于 server/ 目录，或使用绝对路径）
DB_PATH=./data/wms.db

# ===== DB_TYPE=mysql 时使用（其余 sqlite 配置项会被忽略）=====
# MySQL_USER 账号需要有 CREATE DATABASE 权限（首次启动自动建库建表）；
# 如果账号权限受限，请先手动执行:
#   CREATE DATABASE wms_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=wms_db

# 允许跨域访问的来源，多个用逗号分隔；* 表示允许所有来源（局域网部署常用）
CORS_ORIGIN=*
